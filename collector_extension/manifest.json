{
  "manifest_version": 3,
  "key": "",
  "name": "悠悠采集",
  "version": "0.7.1",
  "description": "1688商品页浮窗：优先读取结构化商品、SKU、价格和包装数据，自动进入本机处理队列。",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://*.1688.com/*",
    "https://*.alicdn.com/*",
    "https://*.tbcdn.cn/*",
    "https://itemcdn.tmall.com/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://detail.1688.com/offer/*.html*"
      ],
      "js": [
        "page_bridge.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://detail.1688.com/offer/*.html*"
      ],
      "js": [
        "collector_core.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "悠悠采集",
    "default_icon": "youyou-logo.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "youyou-logo.png"
      ],
      "matches": [
        "https://detail.1688.com/*"
      ]
    }
  ]
}
